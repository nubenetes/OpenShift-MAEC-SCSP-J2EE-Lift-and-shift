<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================================= -->
<!-- Contexto Tomcat JWS 5.4 - Inyección en S2I /opt/jws-5.4/tomcat/conf/     -->
<!-- ======================================================================= -->
<Context>
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>WEB-INF/tomcat-web.xml</WatchedResource>

    <!-- Conexión a Base de Datos Externa vía Servicio Sin Selectores -->
    <Resource name="jdbc/SCSPDataSource"
              auth="Container"
              type="javax.sql.DataSource"
              maxTotal="200"
              maxIdle="50"
              maxWaitMillis="30000"
              username="${DB_USERNAME}"
              password="${DB_PASSWORD}"
              driverClassName="com.microsoft.sqlserver.jdbc.SQLServerDriver"
              url="jdbc:sqlserver://scsp-database-gateway:1433;databaseName=${DB_NAME};sendStringParametersAsUnicode=false"
              validationQuery="SELECT 1"
              testOnBorrow="true"/>

    <!-- Replicación Distribuida de Sesiones HTTP en Infinispan (Red Hat Data Grid) -->
    <Manager className="org.wildfly.clustering.tomcat.hotrod.HotRodManager"
             configurationName="scsp-session-cache"
             hotRodPropertiesFile="hotrod-client.properties" />
</Context>
